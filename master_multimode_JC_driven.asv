function [tgrid, Rho_ee, Rho_eg_trace] = multimode_JC_dissipative(omega, nu0, nmax, J_fluc, J_drive, Drive_integral, T_final, T1, T2)
%MULTIMODE_JC_DISSIPATIVE Lindblad Master Equation Solver for Driven JC Model
%   Solves the interaction-picture Master Equation:
%   d(rho)/dt = -i[V_I(t), rho] + sum( L*rho*L' - 0.5*{L'*L, rho} )
%
%   INPUTS:
%     omega          : 1xK vector of cavity mode frequencies
%     nu0            : TLS transition frequency
%     nmax           : Max photon number per mode
%     J_fluc         : Coupling strength to modes (J)
%     J_drive        : Coupling strength to classical drive
%     Drive_integral : Function handle for drive integral
%     T_final        : Final time
%     T1             : Relaxation time (set Inf if neglected)
%     T2             : Coherence time (set Inf if neglected)
%
%   OUTPUTS:
%     tgrid        : Time points
%     Rho_ee       : Population of TLS Excited state (trace over cavity)
%     Rho_eg_trace : Coherence of TLS (trace over cavity)

%% 1. SYSTEM PARAMETERS & DIMENSIONS
omega = omega(:).';
K = numel(omega);
Delta = nu0 - omega;

% Handle nmax=0 case specifically for efficiency and logic
if nmax == 0
    dim_ph = 1; 
else
    dim_ph = (nmax + 1)^K;
end

dim_tls = 2;
dim_tot = dim_ph * dim_tls;

fprintf('Lindblad Simulation: K=%d, nmax=%d\n', K, nmax);
fprintf('Hilbert Space Dim: %d. Density Matrix Elements: %.2e\n', dim_tot, dim_tot^2);

if dim_tot > 5000
    warning('Large dimension detected. Simulation may consume significant RAM (>16GB).');
end

%% 2. OPERATORS (SPARSE)

% --- TLS Operators (Local) ---
sp = sparse([0 0; 1 0]);    % |e><g|
sm = sp.';                  % |g><e|
sz = sparse([1 0; 0 -1]);   % |e><e| - |g><g|
ee = sparse([1 0; 0 0]);    % |e><e| projector

% --- Full Space Operators ---
Id_ph = speye(dim_ph);
Splus  = kron(Id_ph, sp);
Sminus = kron(Id_ph, sm);
Sz     = kron(Id_ph, sz);
PE     = kron(Id_ph, ee); % Projector onto excited state for all photon states

% --- Cavity Operators ---
% We reuse the function from your previous code logic
if nmax > 0
    A_ops = multimode_annihilation_ops_sparse(nmax, K, dim_tls);
else
    A_ops = {}; % Empty if nmax=0
end

%% 3. INTERACTION HAMILTONIAN COMPONENTS
% V_I(t) = H_JC(t) + H_drive(t)
% We pre-calculate the sparse matrices for the JC parts to avoid re-allocating in loop
JC_plus_ops  = cell(K,1);
JC_minus_ops = cell(K,1);

for k = 1:K
    % If nmax=0, A_ops is empty, loop doesn't generate terms (correct for TLS only)
    if nmax > 0
        JC_plus_ops{k}  = J_fluc * (A_ops{k} * Splus);
        JC_minus_ops{k} = J_fluc * (A_ops{k}' * Sminus);
    end
end

%% 4. DISSIPATION OPERATORS (COLLAPSE OPERATORS)
% L1 = sqrt(1/T1) * sigma_minus
% L2 = sqrt(1/2T2 - 1/4T1) * sigma_z

gamma1 = 0; 
if ~isinf(T1) && T1 > 0
    gamma1 = 1/T1; 
end

gamma_phi = 0;
if ~isinf(T2) && T2 > 0
    % Pure dephasing rate
    val = (1/(2*T2)) - (1/(4*T1));
    if val < -1e-12
        warning('T2 is theoretically too short for given T1 (T2 must be >= 2*T1). forcing gamma_phi=0.');
        val = 0;
    end
    gamma_phi = max(0, val);
end

% Construct L operators in full space
L_ops = {};
if gamma1 > 0
    L1 = sqrt(gamma1) * Sminus;
    L_ops{end+1} = L1;
end
if gamma_phi > 0
    L2 = sqrt(gamma_phi) * Sz;
    L_ops{end+1} = L2;
end

% Pre-compute L' * L for the anti-commutator part
% Lindblad: L*rho*L' - 0.5*( L'L*rho + rho*L'L )
LdagL_sum = sparse(dim_tot, dim_tot);
for i = 1:length(L_ops)
    L = L_ops{i};
    LdagL_sum = LdagL_sum + (L' * L);
end

%% 5. INITIAL STATE
% Ground state: |g> and |0,0...0>
vac_ph = sparse(dim_ph,1);
vac_ph(1) = 1;
g_tls = sparse([0;1]); % [e; g] vector convention in your sp def was 0 0; 1 0 implying row 1=e, row 2=g?
% CHECK: sp = [0 0; 1 0]. If state is [a; b], sp*[a;b] = [0; a]. 
% This implies |e> = [1;0] and |g> = [0;1].
% Let's stick to: |e> is index 1, |g> is index 2.
rho0_vec = sparse(dim_tot^2, 1);

% Initial state is pure |g, vac>
psi0 = kron(vac_ph, g_tls);
rho0 = psi0 * psi0';
rho0_vec = rho0(:); % Flatten to column vector for ODE solver

%% 6. ODE SOLVER
% Classical Drive Function
% f(t) matches your previous definition exactly
f = @(t) -1i * J_drive * J_fluc * Drive_integral(t) .* exp(1i * nu0 * t);

% RHS Function
rhs = @(t, rho_vec) lindblad_rhs(t, rho_vec, dim_tot, Delta, JC_plus_ops, JC_minus_ops, Splus, Sminus, f, L_ops, LdagL_sum);

% Solver Options
% Using ode23 (low order) to save memory on internal stages compared to ode45
% for such huge systems. If nmax is small, ode45 is fine.
if dim_tot > 100
    solver = @ode23; 
else
    solver = @ode45;
end

fprintf('Starting time integration...\n');
opts = odeset('RelTol', 1e-6, 'AbsTol', 1e-6); % Looser tolerances for speed on huge matrices
[tgrid, rho_all_vec] = solver(rhs, [0, T_final], rho0_vec, opts);

%% 7. POST-PROCESSING (Extract Observables)
nt = length(tgrid);
Rho_ee = zeros(nt, 1);
Rho_eg_trace = zeros(nt, 1);

fprintf('Post-processing %d time steps...\n', nt);

% Reconstruct Rho at every time step to take partial trace
% Since we only need <e|rho|e>, we can do this via dot products without reshaping everything
% But reshaping is clearer.
% P_e = tr( (|e><e| x I) * rho )
% This corresponds to summing diagonal elements corresponding to |e>

% Create a logical mask for Excited state indices
% Since structure is kron(Ph, TLS), and TLS is inner:
% Indices: 1=(vac,e), 2=(vac,g), 3=(1ph,e), 4=(1ph,g)...
% Excited states are odd indices: 1, 3, 5...
idx_e = 1:2:dim_tot;
idx_g = 2:2:dim_tot;

for i = 1:nt
    % Extract current rho vector
    v = rho_all_vec(i,:).'; 
    
    % Calculation of Population (Sum of diagonal elements corresponding to e)
    % The vector stores rho column-wise. Diagonal elements rho_ii are at indices (i-1)*dim + i
    % However, calculating via indices is complex.
    % Easiest way: Reshape the DIAGONAL only? No.
    
    % Let's reshape just the current step. 
    % Note: rho_all_vec is (Time x N^2). It might be huge.
    % We process row by row to save RAM.
    
    rho_curr = reshape(v, dim_tot, dim_tot);
    
    % Population
    % Sum of diagonal elements where TLS is excited
    Rho_ee(i) = sum(real(diag(rho_curr(idx_e, idx_e))));
    
    % Coherence <e|rho|g> (Traced over photon modes)
    % Sum of off-diagonal blocks
    % The coherence corresponds to |e><g| elements.
    % In our basis (kron(Ph, TLS)), these are elements (n,e), (n,g).
    % i.e. rho( odd, even ). 
    % Specifically, for the same photon state n: rho( (n,e), (n,g) ).
    % These are elements at indices (idx_e(k), idx_g(k))
    
    coherence_sum = 0;
    for k = 1:numel(idx_e)
        coherence_sum = coherence_sum + rho_curr(idx_e(k), idx_g(k));
    end
    Rho_eg_trace(i) = coherence_sum;
end

end

%% ================= LOCAL FUNCTIONS =================

function drho_dt_vec = lindblad_rhs(t, rho_vec, dim, Delta, JC_plus, JC_minus, Sp, Sm, f_func, L_ops, LdagL_sum)
    % 1. Reshape vector to matrix
    rho = reshape(rho_vec, dim, dim);
    
    % 2. Calculate Hamiltonian V(t) [Interaction Picture]
    ft = f_func(t);
    
    % Drive term: f(t)*S+ + f*(t)*S-
    V = ft * Sp + conj(ft) * Sm;
    
    % JC terms
    % Sum_k ( J * e^{i*dT} * a * S+  + h.c. )
    K = numel(Delta);
    for k = 1:K
        phase = exp(1i * Delta(k) * t);
        % JC_plus is (a * S+). We need e^{iDt} * (a S+)
        V = V + (phase * JC_plus{k}) + (conj(phase) * JC_minus{k});
    end
    
    % 3. Commutator -i[H, rho]
    % dRho_H = -1i * (V*rho - rho*V);
    % Optimization: V is sparse, rho is dense.
    comm = -1i * (V * rho - rho * V);
    
    % 4. Dissipator
    % D(rho) = Sum ( L rho L' - 0.5 {L'L, rho} )
    diss = sparse(dim, dim);
    
    % Anti-commutator part (pre-summed LdagL)
    % -0.5 * ( LdagL_sum * rho + rho * LdagL_sum )
    ac = -0.5 * (LdagL_sum * rho + rho * LdagL_sum);
    
    % Quantum Jump part ( L rho L' )
    jump = sparse(dim, dim);
    for i = 1:length(L_ops)
        L = L_ops{i};
        jump = jump + (L * rho * L');
    end
    
    drho_dt = comm + jump + ac;
    
    % 5. Reshape back to vector
    drho_dt_vec = drho_dt(:);
end

% --- Helper for Sparse Annihilation Ops (Copied from your code) ---
function A_ops = multimode_annihilation_ops_sparse(nmax, K, dim_tls)
    dim_ph1 = nmax + 1;
    % Single mode a
    vals = sqrt(1:nmax).';
    B = zeros(nmax+1,1);
    B(1:nmax) = vals;
    a_single = spdiags(B,1,nmax+1,nmax+1);

    Id_tls = speye(dim_tls);
    A_ops = cell(K,1);
    for kk = 1:K
        op_ph = 1;
        for mm = 1:K
            if mm == kk
                M = a_single;
            else
                M = speye(dim_ph1);
            end
            op_ph = kron(op_ph,M);
        end
        A_ops{kk} = kron(op_ph,Id_tls);
    end
end